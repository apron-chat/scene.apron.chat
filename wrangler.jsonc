// scene.apron.chat: Apron archives (scenes/*.jsonl) served read-only over the
// protocol, one Durable Object per scene. See README.md.
//
// Workers Builds ignores `build`: its Build command must also be
// `npm run build`.
{
	"name": "scene-apron-chat",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-15",
	"workers_dev": false,
	"preview_urls": true,
	"routes": [{ "pattern": "scene.apron.chat", "custom_domain": true }],
	"build": { "command": "npm run build" },
	// /<name>.jsonl is the scene's file, served without running the Worker.
	// Every other path runs it: no other file is in scenes/.
	"assets": { "directory": "./scenes" },
	"durable_objects": {
		"bindings": [{ "name": "SCENE", "class_name": "SceneServer" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["SceneServer"] }],
	// WebSockets per client address, checked before a Durable Object is
	// reached. The namespace_id is unique within the account.
	"ratelimits": [
		{ "name": "CONNECTIONS", "namespace_id": "74001", "simple": { "limit": 30, "period": 60 } }
	],
	"observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
