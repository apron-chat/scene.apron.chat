// scene.apron.chat: Apron archives (scenes/<name>/scene.jsonl) served read-only over the
// protocol by one Worker, compiled into it at build time. See README.md.
//
// Workers Builds ignores `build`: its Build command must also be
// `npm run build`.
{
	"name": "scene-apron-chat",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-15",
	"workers_dev": false,
	"preview_urls": true,
	"routes": [{ "pattern": "scene.apron.chat", "custom_domain": true }],
	// Without this, `wrangler dev` hands the Worker requests for the route's
	// host, scene.apron.chat, and the scene's media and links would point
	// there rather than at the dev server.
	"dev": { "host": "localhost:8787" },
	"build": { "command": "npm run build" },
	// Each scene's directory, its file (/<name>/scene.jsonl) and its media,
	// served without running the Worker. Every other path runs it.
	"assets": { "directory": "./scenes" },
	// WebSockets per client address, checked before a scene is served. The
	// namespace_id is unique within the account.
	"ratelimits": [
		{ "name": "CONNECTIONS", "namespace_id": "74001", "simple": { "limit": 30, "period": 60 } }
	],
	// Pull request builds run `wrangler preview`. A Preview gets none of the
	// bindings above unless they are declared here too; its rate limit uses
	// its own namespace.
	"previews": {
		"ratelimits": [
			{ "name": "CONNECTIONS", "namespace_id": "74002", "simple": { "limit": 30, "period": 60 } }
		]
	},
	"observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
